AI_API_KEY=tu_api_key_de_openai
AI_BASE_URL=https://api.openai.com/v1
# Por dificultad (Jev). Si falta una, el default está en el código.
AI_MODEL_MINI=gpt-4.1-nano
AI_MODEL_MEDIO=gpt-4.1-mini
AI_MODEL_ALTO=gpt-4.1
AI_MODEL_FALLBACK=gpt-4.1-mini

# Preproceso Jev. Si falta, /chat sigue sin clasificar el turno.
TYPESAFE_API_KEY=

# Base de datos local (docker compose up -d). Puerto 5433, no 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=papdb
DB_USER=pap
DB_PASSWORD=pap

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=pap
